{
  "expo": {
    "name": "Bookshelf",
    "slug": "bookshelf",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bookshelf",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#6B4EFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sharvaribhimte.bookshelf"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#6B4EFF"
      },
      "package": "com.sharvaribhimte.bookshelf"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#6B4EFF",
          "image": "./assets/images/icon.png",
          "imageWidth": 150
        }
      ]
    ]
  }
}
